# Cloudflare R2 Configuration Template
# Copy these variables to Railway environment settings

# Enable Cloudflare R2 storage
USE_CLOUDFLARE_R2=true

# Cloudflare R2 Credentials (get from Cloudflare Dashboard > R2 > Manage R2 API tokens)
CLOUDFLARE_R2_ACCESS_KEY_ID=your_access_key_here
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_secret_key_here

# Cloudflare R2 Bucket Configuration
CLOUDFLARE_R2_BUCKET_NAME=seamap-media
CLOUDFLARE_R2_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com

# Optional: Custom domain for faster access (setup in Cloudflare R2 > Settings > Custom Domain)
CLOUDFLARE_R2_CUSTOM_DOMAIN=media.yourdomain.com

# Instructions:
# 1. Create Cloudflare R2 bucket at https://dash.cloudflare.com/r2
# 2. Get your account ID from the right sidebar
# 3. Create R2 API token with Edit permissions
# 4. Replace the values above with your actual credentials
# 5. Add these environment variables to Railway
